{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "bg0": "#000000",
    "bg1": "#000000",
    "bg2": "#0A0A0A",
    "bg3": "#2A2A2A",
    "red0": "#8B0000",
    "red1": "#FF0000",
    "red2": "#FF3333",
    "red3": "#FF5555",
    "red4": "#FF7777",
    "gray0": "#3A3A3A",
    "gray1": "#909090",
    "gray2": "#C0C0C0",
    "text0": "#FFFFFF",
    "text1": "#FFFFFF",
    "green0": "#00FF66",
    "yellow0": "#FFDD00",
    "orange0": "#FF8800",
    "cyan0": "#00FFFF",
    "purple0": "#CC44FF",
    "blue0": "#3399FF"
  },
  "theme": {
    "primary": {
      "dark": "red1",
      "light": "red0"
    },
    "secondary": {
      "dark": "red2",
      "light": "red1"
    },
    "accent": {
      "dark": "red2",
      "light": "red1"
    },
    "error": {
      "dark": "red1",
      "light": "red1"
    },
    "warning": {
      "dark": "yellow0",
      "light": "yellow0"
    },
    "success": {
      "dark": "green0",
      "light": "green0"
    },
    "info": {
      "dark": "orange0",
      "light": "orange0"
    },
    "text": {
      "dark": "text0",
      "light": "bg0"
    },
    "textMuted": {
      "dark": "gray2",
      "light": "gray0"
    },
    "background": {
      "dark": "bg0",
      "light": "text1"
    },
    "backgroundPanel": {
      "dark": "bg1",
      "light": "text1"
    },
    "backgroundElement": {
      "dark": "bg2",
      "light": "text1"
    },
    "border": {
      "dark": "bg3",
      "light": "gray0"
    },
    "borderActive": {
      "dark": "red1",
      "light": "gray0"
    },
    "borderSubtle": {
      "dark": "bg2",
      "light": "gray0"
    },
    "diffAdded": {
      "dark": "green0",
      "light": "green0"
    },
    "diffRemoved": {
      "dark": "red1",
      "light": "red1"
    },
    "diffContext": {
      "dark": "gray1",
      "light": "gray0"
    },
    "diffHunkHeader": {
      "dark": "gray1",
      "light": "gray0"
    },
    "diffHighlightAdded": {
      "dark": "green0",
      "light": "green0"
    },
    "diffHighlightRemoved": {
      "dark": "red1",
      "light": "red1"
    },
    "diffAddedBg": {
      "dark": "#0A2E0A",
      "light": "#E6F5E6"
    },
    "diffRemovedBg": {
      "dark": "#2E0A0A",
      "light": "#F5E6E6"
    },
    "diffContextBg": {
      "dark": "bg1",
      "light": "gray2"
    },
    "diffLineNumber": {
      "dark": "bg3",
      "light": "gray2"
    },
    "diffAddedLineNumberBg": {
      "dark": "#0A2E0A",
      "light": "#DDEDDD"
    },
    "diffRemovedLineNumberBg": {
      "dark": "#2E0A0A",
      "light": "#EDDDDD"
    },
    "markdownText": {
      "dark": "text0",
      "light": "bg0"
    },
    "markdownHeading": {
      "dark": "red2",
      "light": "red0"
    },
    "markdownLink": {
      "dark": "orange0",
      "light": "red1"
    },
    "markdownLinkText": {
      "dark": "red3",
      "light": "red0"
    },
    "markdownCode": {
      "dark": "green0",
      "light": "green0"
    },
    "markdownBlockQuote": {
      "dark": "gray2",
      "light": "gray0"
    },
    "markdownEmph": {
      "dark": "yellow0",
      "light": "yellow0"
    },
    "markdownStrong": {
      "dark": "red4",
      "light": "red1"
    },
    "markdownHorizontalRule": {
      "dark": "bg3",
      "light": "gray0"
    },
    "markdownListItem": {
      "dark": "red3",
      "light": "red0"
    },
    "markdownListEnumeration": {
      "dark": "orange0",
      "light": "red1"
    },
    "markdownImage": {
      "dark": "orange0",
      "light": "red1"
    },
    "markdownImageText": {
      "dark": "red3",
      "light": "red0"
    },
    "markdownCodeBlock": {
      "dark": "text0",
      "light": "bg0"
    },
    "syntaxComment": {
      "dark": "gray1",
      "light": "gray0"
    },
    "syntaxKeyword": {
      "dark": "red1",
      "light": "red0"
    },
    "syntaxFunction": {
      "dark": "orange0",
      "light": "orange0"
    },
    "syntaxVariable": {
      "dark": "red4",
      "light": "red1"
    },
    "syntaxString": {
      "dark": "green0",
      "light": "green0"
    },
    "syntaxNumber": {
      "dark": "yellow0",
      "light": "yellow0"
    },
    "syntaxType": {
      "dark": "red2",
      "light": "red0"
    },
    "syntaxOperator": {
      "dark": "red1",
      "light": "red0"
    },
    "syntaxPunctuation": {
      "dark": "gray2",
      "light": "bg0"
    }
  }
}