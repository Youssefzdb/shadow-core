{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "bg0": "#0D0D0D",
    "bg1": "#1A1A1A",
    "bg2": "#252525",
    "bg3": "#333333",
    "red0": "#8B0000",
    "red1": "#CC0000",
    "red2": "#FF3333",
    "red3": "#FF6666",
    "gray0": "#4A4A4A",
    "gray1": "#8B95A7",
    "gray2": "#B0B0B0",
    "text0": "#E0E0E0",
    "text1": "#F0F0F0",
    "green0": "#00AA44",
    "yellow0": "#FFAA00",
    "orange0": "#FF6B35"
  },
  "theme": {
    "primary": { "dark": "red1", "light": "red0" },
    "secondary": { "dark": "red0", "light": "red1" },
    "accent": { "dark": "red2", "light": "red1" },
    "error": { "dark": "red2", "light": "red2" },
    "warning": { "dark": "yellow0", "light": "yellow0" },
    "success": { "dark": "green0", "light": "green0" },
    "info": { "dark": "orange0", "light": "orange0" },
    "text": { "dark": "text0", "light": "bg0" },
    "textMuted": { "dark": "gray1", "light": "gray0" },
    "background": { "dark": "bg0", "light": "text1" },
    "backgroundPanel": { "dark": "bg1", "light": "gray2" },
    "backgroundElement": { "dark": "bg2", "light": "gray2" },
    "border": { "dark": "bg3", "light": "gray0" },
    "borderActive": { "dark": "red0", "light": "gray0" },
    "borderSubtle": { "dark": "bg2", "light": "gray0" },
    "diffAdded": { "dark": "green0", "light": "green0" },
    "diffRemoved": { "dark": "red2", "light": "red2" },
    "diffContext": { "dark": "gray1", "light": "gray0" },
    "diffHunkHeader": { "dark": "gray1", "light": "gray0" },
    "diffHighlightAdded": { "dark": "green0", "light": "green0" },
    "diffHighlightRemoved": { "dark": "red2", "light": "red2" },
    "diffAddedBg": { "dark": "#1A2E1A", "light": "#E6F5E6" },
    "diffRemovedBg": { "dark": "#2E1A1A", "light": "#F5E6E6" },
    "diffContextBg": { "dark": "bg1", "light": "gray2" },
    "diffLineNumber": { "dark": "bg3", "light": "gray2" },
    "diffAddedLineNumberBg": { "dark": "#1A2E1A", "light": "#DDEDDD" },
    "diffRemovedLineNumberBg": { "dark": "#2E1A1A", "light": "#EDDDDD" },
    "markdownText": { "dark": "text0", "light": "bg0" },
    "markdownHeading": { "dark": "red2", "light": "red0" },
    "markdownLink": { "dark": "orange0", "light": "red1" },
    "markdownLinkText": { "dark": "red2", "light": "red0" },
    "markdownCode": { "dark": "green0", "light": "green0" },
    "markdownBlockQuote": { "dark": "gray1", "light": "gray0" },
    "markdownEmph": { "dark": "yellow0", "light": "yellow0" },
    "markdownStrong": { "dark": "red3", "light": "red1" },
    "markdownHorizontalRule": { "dark": "bg3", "light": "gray0" },
    "markdownListItem": { "dark": "red2", "light": "red0" },
    "markdownListEnumeration": { "dark": "orange0", "light": "red1" },
    "markdownImage": { "dark": "orange0", "light": "red1" },
    "markdownImageText": { "dark": "red2", "light": "red0" },
    "markdownCodeBlock": { "dark": "text0", "light": "bg0" },
    "syntaxComment": { "dark": "gray1", "light": "gray0" },
    "syntaxKeyword": { "dark": "red1", "light": "red0" },
    "syntaxFunction": { "dark": "orange0", "light": "orange0" },
    "syntaxVariable": { "dark": "red3", "light": "red1" },
    "syntaxString": { "dark": "green0", "light": "green0" },
    "syntaxNumber": { "dark": "yellow0", "light": "yellow0" },
    "syntaxType": { "dark": "red2", "light": "red0" },
    "syntaxOperator": { "dark": "red1", "light": "red0" },
    "syntaxPunctuation": { "dark": "gray2", "light": "bg0" }
  }
}
